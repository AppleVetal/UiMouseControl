import com.github.kwhat.jnativehook.GlobalScreen;
import com.github.kwhat.jnativehook.NativeHookException;
import com.github.kwhat.jnativehook.keyboard.NativeKeyEvent;
import com.github.kwhat.jnativehook.keyboard.NativeKeyListener;
import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.google.gson.reflect.TypeToken;
import com.sun.jna.Pointer;
import com.sun.jna.Structure;
import com.sun.jna.platform.win32.User32;
import com.sun.jna.platform.win32.WinDef;
import com.sun.jna.platform.win32.WinUser.HHOOK;
import com.sun.jna.platform.win32.WinDef.LPARAM;
import com.sun.jna.platform.win32.WinDef.LRESULT;
import com.sun.jna.platform.win32.WinDef.WPARAM;
import com.sun.jna.platform.win32.WinUser;

import javax.swing.*;
import javax.swing.filechooser.FileNameExtensionFilter;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.InputEvent;
import java.io.*;
import java.lang.reflect.Type;
import java.util.*;
import java.util.List;
import java.util.logging.Level;
import java.util.logging.Logger;

public class MouseRecorder {

    public enum ActionType { MOVE, PRESS, RELEASE }

    public static class MouseAction {
        long timeOffset; int x, y; ActionType type; int buttonMask;
        private MouseAction() {}
        public MouseAction(long t, int x, int y, ActionType type, int mask) {
            this.timeOffset = t; this.x = x; this.y = y; this.type = type; this.buttonMask = mask;
        }
    }

    // Явные константы Windows
    private static final int WH_MOUSE_LL = 14;
    private static final int WM_LBUTTONDOWN = 0x0201;
    private static final int WM_LBUTTONUP = 0x0202;
    private static final int WM_RBUTTONDOWN = 0x0204;
    private static final int WM_RBUTTONUP = 0x0205;
    private static final int WM_MBUTTONDOWN = 0x0207;
    private static final int WM_MBUTTONUP = 0x0208;

    // ✅ JNA-структура для WH_MOUSE_LL (совместима с JNA 5.x)
    @Structure.FieldOrder({"pt", "mouseData", "flags", "time", "dwExtraInfo"})
    public static class MSLLHOOKSTRUCT extends Structure {
        public WinDef.POINT pt = new WinDef.POINT();
        public int mouseData;
        public int flags;
        public int time;
        public int dwExtraInfo;

        public MSLLHOOKSTRUCT(Pointer p) {
            super(p);
            read();
        }
    }

    // Состояние приложения
    private static final List<MouseAction> actions = Collections.synchronizedList(new ArrayList<>());
    private static volatile boolean isRecording = false;
    private static volatile boolean isPlaying = false;
    private static volatile boolean isStoppingPlayback = false;
    private static volatile boolean pollingActive = true;
    private static long startTime = 0;

    private static volatile int mouseX = 0, mouseY = 0;
    private static volatile boolean[] btnState = new boolean[4];
    private static volatile long lastUiUpdate = 0;

    private static JFrame mainFrame;
    private static JPanel mainPanel;
    private static final String TITLE = "Global Mouse Recorder | [R] запись, [P] play, [Esc] стоп, [S/L] json, [Q] выход";

    // ✅ Исправлено: тип соответствует User32.SetWindowsHookEx
    private static HHOOK mouseHook = null;
    //private static WinUser.HOOKPROC mouseProc = null;
    private static WinUser.LowLevelMouseProc mouseProc = null;

    public static void main(String[] args) {
        Logger.getLogger(GlobalScreen.class.getName()).setLevel(Level.OFF);
        mainFrame = createUI();
        mainFrame.setVisible(true);

        setupGlobalHotkeys();
        installLowLevelMouseHook();

        Runtime.getRuntime().addShutdownHook(new Thread(() -> {
            pollingActive = false;
            uninstallMouseHook();
            try { GlobalScreen.unregisterNativeHook(); } catch (NativeHookException ignored) {}
        }));
    }

    private static void installLowLevelMouseHook() {
        try {
            // Явное указание типов параметров решает ошибки inference и longValue()
            mouseProc = //(int nCode, WinDef.WPARAM wParam, WinDef.LPARAM lParam) -> {
                    (nCode, wParam, lParam) -> {
                if (nCode >= 0) {
                    // lParam содержит указатель на MSLLHOOKSTRUCT в памяти ОС
                    //long ptrAddress = lParam.longValue(); // Получаем адрес
                    //WinUser.MSLLHOOKSTRUCT mhs = new WinUser.MSLLHOOKSTRUCT();
                    //MSLLHOOKSTRUCT mhs = new MSLLHOOKSTRUCT(new Pointer(ptrAddress));
                    MSLLHOOKSTRUCT mhs = new MSLLHOOKSTRUCT(lParam.pt.getPointer());
                    mhs.pt = lParam.pt;

                    int x = mhs.pt.x;
                    int y = mhs.pt.y;
                    int msg = (int) wParam.longValue();

                    if (mouseX != x || mouseY != y) {
                        mouseX = x;
                        mouseY = y;
                        if (isRecording) {
                            actions.add(new MouseAction(System.currentTimeMillis() - startTime, x, y, ActionType.MOVE, 0));
                        }
                        updateUI();
                    }

                    ActionType type = null;
                    int btn = 0, mask = 0;
                    switch (msg) {
                        case WM_LBUTTONDOWN: btn=1; mask=InputEvent.BUTTON1_DOWN_MASK; type=ActionType.PRESS; break;
                        case WM_LBUTTONUP:   btn=1; mask=InputEvent.BUTTON1_DOWN_MASK; type=ActionType.RELEASE; break;
                        case WM_MBUTTONDOWN: btn=2; mask=InputEvent.BUTTON2_DOWN_MASK; type=ActionType.PRESS; break;
                        case WM_MBUTTONUP:   btn=2; mask=InputEvent.BUTTON2_DOWN_MASK; type=ActionType.RELEASE; break;
                        case WM_RBUTTONDOWN: btn=3; mask=InputEvent.BUTTON3_DOWN_MASK; type=ActionType.PRESS; break;
                        case WM_RBUTTONUP:   btn=3; mask=InputEvent.BUTTON3_DOWN_MASK; type=ActionType.RELEASE; break;
                    }

                    if (type != null) {
                        btnState[btn] = (type == ActionType.PRESS);
                        if (isRecording) {
                            actions.add(new MouseAction(System.currentTimeMillis() - startTime, mouseX, mouseY, type, mask));
                        }
                        updateUI();
                    }
                }
                // wParam и lParam уже имеют правильные типы, передаём их напрямую
                return User32.INSTANCE.CallNextHookEx(mouseHook, nCode, wParam, new LPARAM(lParam.pt.getPointer().getLong(0)));
            };

            mouseHook = User32.INSTANCE.SetWindowsHookEx(WH_MOUSE_LL, mouseProc, null, 0);
            if (mouseHook == null) {
                System.err.println("⚠️ Не удалось установить хук. Запустите JAR от имени Администратора.");
            } else {
                System.out.println("🌍 WH_MOUSE_LL успешно установлен.");
            }
        } catch (Exception e) {
            System.err.println("❌ Ошибка хука: " + e.getMessage());
        }
    }

    private static void installLowLevelMouseHook_old1() {
        try {
            mouseProc = (nCode, wParam, lParam) -> {
//            mouseProc = (int nCode,
//                         com.sun.jna.platform.win32.WinDef.WPARAM wParam,
//                         com.sun.jna.platform.win32.WinDef.LPARAM lParam) -> {
                if (nCode >= 0) {
                    //Pointer ptr = new Pointer(lParam.longValue());
//                    Pointer ptr = new Pointer(lParam);
                    WinUser.MSLLHOOKSTRUCT mhs = new WinUser.MSLLHOOKSTRUCT();
                    mhs.pt = lParam.pt;

//                    com.sun.jna.Pointer ptr = new com.sun.jna.Pointer(lParam.longValue());
//                    WinUser.MSLLHOOKSTRUCT mhs = new WinUser.MSLLHOOKSTRUCT();
//                    mhs.pt = new WinDef.POINT(ptr);

                    int x = mhs.pt.x;
                    int y = mhs.pt.y;
                    //int msg = wParam.intValue();
                    int msg = (int) wParam.longValue();

                    if (mouseX != x || mouseY != y) {
                        mouseX = x;
                        mouseY = y;
                        if (isRecording) {
                            actions.add(new MouseAction(System.currentTimeMillis() - startTime, x, y, ActionType.MOVE, 0));
                        }
                        updateUI();
                    }

                    ActionType type = null;
                    int btn = 0, mask = 0;
                    switch (msg) {
                        case WM_LBUTTONDOWN:
                            btn = 1;
                            mask = InputEvent.BUTTON1_DOWN_MASK;
                            type = ActionType.PRESS;
                            break;
                        case WM_LBUTTONUP:
                            btn = 1;
                            mask = InputEvent.BUTTON1_DOWN_MASK;
                            type = ActionType.RELEASE;
                            break;
                        case WM_MBUTTONDOWN:
                            btn = 2;
                            mask = InputEvent.BUTTON2_DOWN_MASK;
                            type = ActionType.PRESS;
                            break;
                        case WM_MBUTTONUP:
                            btn = 2;
                            mask = InputEvent.BUTTON2_DOWN_MASK;
                            type = ActionType.RELEASE;
                            break;
                        case WM_RBUTTONDOWN:
                            btn = 3;
                            mask = InputEvent.BUTTON3_DOWN_MASK;
                            type = ActionType.PRESS;
                            break;
                        case WM_RBUTTONUP:
                            btn = 3;
                            mask = InputEvent.BUTTON3_DOWN_MASK;
                            type = ActionType.RELEASE;
                            break;
                    }

                    if (type != null) {
                        btnState[btn] = (type == ActionType.PRESS);
                        if (isRecording) {
                            actions.add(new MouseAction(System.currentTimeMillis() - startTime, mouseX, mouseY, type, mask));
                        }
                        updateUI();
                    }
                }
                return User32.INSTANCE.CallNextHookEx(
                        mouseHook,
                        nCode,
                        new com.sun.jna.platform.win32.WinDef.WPARAM(wParam.longValue()),
                        //new com.sun.jna.platform.win32.WinDef.LPARAM(lParam.longValue())
                        new WinDef.LPARAM(lParam.dwExtraInfo.longValue())
                );

                // Передаём управление следующему хуку в цепочке
                //CallNextHookEx(WinUser.HHOOK var1, int var2, WinDef.WPARAM var3, WinDef.LPARAM var4);
                //return User32.INSTANCE.CallNextHookEx(mouseHook, nCode, wParam, lParam);

//                Pointer ptr = lParam.getPointer();
//                long peer = Pointer.nativeValue(ptr);
//                return User32.INSTANCE.CallNextHookEx(mouseHook, nCode, wParam, lParam.pt);

            };

            // Устанавливаем глобальный хук
            mouseHook = User32.INSTANCE.SetWindowsHookEx(WH_MOUSE_LL, mouseProc, null, 0);
            if (mouseHook == null) {
                System.err.println("⚠️ Не удалось установить хук. Запустите JAR от имени Администратора.");
            } else {
                System.out.println("🌍 WH_MOUSE_LL успешно установлен.");
            }
        } catch (Exception e) {
            System.err.println("❌ Ошибка хука: " + e.getMessage());
        }
    }

    private static void uninstallMouseHook() {
        if (mouseHook != null) {
            User32.INSTANCE.UnhookWindowsHookEx(mouseHook);
            mouseHook = null;
        }
    }

    private static void updateUI() {
        long now = System.currentTimeMillis();
        if (now - lastUiUpdate > 33) {
            lastUiUpdate = now;
            SwingUtilities.invokeLater(mainPanel::repaint);
        }
    }

    private static JFrame createUI() {
        JFrame frame = new JFrame(TITLE);
        frame.setSize(800, 600);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setAlwaysOnTop(true);
        frame.setFocusableWindowState(false);

        mainPanel = new JPanel() {
            { setFocusable(false); setBackground(new Color(30, 30, 35, 210));
              setBorder(BorderFactory.createLineBorder(new Color(80, 80, 80), 2)); }
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                Graphics2D g2 = (Graphics2D) g;
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                g2.setColor(Color.WHITE);
                g2.setFont(new Font("Consolas", Font.BOLD, 13));

                g2.drawString("🌍 Окно всегда поверх | Клики проходят сквозь", 20, 30);
                g2.drawString("📝 [R] Запись | ▶️ [P] Play | ⏹ [Esc] Стоп", 20, 55);
                g2.drawString("💾 [S] Сохранить | 📂 [L] Загрузить | [Q] Выход", 20, 80);

                String status = isPlaying ? "▶️ Воспроизведение..." :
                                isRecording ? "🔴 ЗАПИСЬ АКТИВНА" :
                                "⏸ Ожидание (" + actions.size() + " событий)";
                g2.drawString("Статус: " + status, 20, 115);

                g2.setFont(new Font("Consolas", Font.BOLD, 15));
                g2.drawString(String.format("📍 X: %4d  Y: %4d", mouseX, mouseY), 20, 160);

                String btnText = String.format("🖱 LMB: %s  MMB: %s  RMB: %s",
                    drawBtn(btnState[1]), drawBtn(btnState[2]), drawBtn(btnState[3]));
                g2.drawString(btnText, 20, 190);

                g2.setFont(new Font("Consolas", Font.PLAIN, 11));
                g2.setColor(Color.GRAY);
                g2.drawString("⬤ = нажата  ○ = отпущена", 20, 220);
            }
            private String drawBtn(boolean pressed) { return pressed ? "⬤" : "○"; }
        };
        frame.add(mainPanel);
        return frame;
    }

    private static void setupGlobalHotkeys() {
        try {
            GlobalScreen.addNativeKeyListener(new NativeKeyListener() {
                @Override public void nativeKeyPressed(NativeKeyEvent e) {
                    int code = e.getKeyCode();
                    if (code == NativeKeyEvent.VC_R) toggleRecording();
                    else if (code == NativeKeyEvent.VC_P && !isRecording && !actions.isEmpty() && !isPlaying)
                        new Thread(MouseRecorder::playback).start();
                    else if (code == NativeKeyEvent.VC_ESCAPE) stopPlayback();
                    else if (code == NativeKeyEvent.VC_S) saveToJson(mainFrame);
                    else if (code == NativeKeyEvent.VC_L) loadFromJson(mainFrame);
                    else if (code == NativeKeyEvent.VC_Q) System.exit(0);
                }
                @Override public void nativeKeyReleased(NativeKeyEvent e) {}
                @Override public void nativeKeyTyped(NativeKeyEvent e) {}
            });
        } catch (Exception ex) { System.err.println("❌ Ошибка клавиатурного хука: " + ex); }
    }

    private static void toggleRecording() {
        isRecording = !isRecording;
        if (isRecording) { actions.clear(); startTime = System.currentTimeMillis(); System.out.println("🟢 Запись начата"); }
        else System.out.println("⏹ Запись остановлена. Сохранено: " + actions.size());
        updateUI();
    }

    private static void stopPlayback() {
        if (isPlaying) { isStoppingPlayback = true; System.out.println("⏹ Воспроизведение остановлено."); }
    }

    private static void moveCursorSmart(int targetX, int targetY) {
        try {
            Robot robot = new Robot();
            Point cur = MouseInfo.getPointerInfo().getLocation();
            int dx = targetX - cur.x, dy = targetY - cur.y;
            if (Math.abs(dx) < 10 && Math.abs(dy) < 10) { robot.mouseMove(targetX, targetY); return; }
            int steps = Math.max(1, Math.max(Math.abs(dx), Math.abs(dy)) / 5);
            int sx = dx / steps, sy = dy / steps;
            for (int i = 0; i < steps; i++) {
                if (isStoppingPlayback) return;
                robot.mouseMove(cur.x + sx * (i + 1), cur.y + sy * (i + 1));
                Thread.sleep(5);
            }
        } catch (Exception ignored) {}
    }

    private static void playback() {
        isPlaying = true; isStoppingPlayback = false;
        System.out.println("▶️ Начинаю воспроизведение...");
        try {
            long lastTime = 0;
            List<MouseAction> snap = new ArrayList<>(actions);
            for (MouseAction a : snap) {
                if (isStoppingPlayback) break;
                long delay = a.timeOffset - lastTime;
                if (delay > 0) { long rem = delay; while (rem > 0 && !isStoppingPlayback) { Thread.sleep(Math.min(rem, 50)); rem -= 50; } }
                if (isStoppingPlayback) break;
                lastTime = a.timeOffset;
                moveCursorSmart(a.x, a.y);
                if (a.type == ActionType.PRESS) new Robot().mousePress(a.buttonMask);
                else if (a.type == ActionType.RELEASE) new Robot().mouseRelease(a.buttonMask);
            }
            System.out.println(isStoppingPlayback ? "⏹ Прервано." : "✅ Завершено.");
        } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
        catch (AWTException e) { e.printStackTrace(); }
        finally { isPlaying = false; isStoppingPlayback = false; updateUI(); }
    }

    private static void saveToJson(JFrame parent) {
        if (actions.isEmpty()) { System.out.println("⚠️ Нечего сохранять."); return; }
        JFileChooser c = new JFileChooser(); c.setFileFilter(new FileNameExtensionFilter("JSON Macro", "json"));
        c.setSelectedFile(new File("mouse_macro.json"));
        if (c.showSaveDialog(parent) == JFileChooser.APPROVE_OPTION) {
            try (Writer w = new FileWriter(c.getSelectedFile())) {
                new GsonBuilder().setPrettyPrinting().create().toJson(actions, w);
                System.out.println("💾 Сохранено: " + c.getSelectedFile().getAbsolutePath());
            } catch (IOException ex) { System.err.println("❌ Ошибка: " + ex.getMessage()); }
        }
    }

    private static void loadFromJson(JFrame parent) {
        JFileChooser c = new JFileChooser(); c.setFileFilter(new FileNameExtensionFilter("JSON Macro", "json"));
        if (c.showOpenDialog(parent) == JFileChooser.APPROVE_OPTION) {
            try (Reader r = new FileReader(c.getSelectedFile())) {
                Type listType = new TypeToken<List<MouseAction>>(){}.getType();
                List<MouseAction> loaded = new Gson().fromJson(r, listType);
                if (loaded != null && !loaded.isEmpty()) {
                    actions.clear(); actions.addAll(loaded); isRecording = false;
                    System.out.println("📂 Загружено " + loaded.size() + " действий.");
                    updateUI();
                }
            } catch (Exception ex) { System.err.println("❌ Ошибка загрузки: " + ex.getMessage()); }
        }
    }
}
